# Base de donnees locale. En production, utiliser une URL Postgres/Supabase.
DATABASE_URL="file:./dev.db"
# DIRECT_URL est requis surtout avec Prisma + Postgres pooler en production.
# DIRECT_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"

# URL publique de l'application, utilisee pour les liens emails, sitemap et robots.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js v5
# Generer avec: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# En production/Vercel, laisser a true pour faire confiance au host fourni.
AUTH_TRUST_HOST="true"

# Emails transactionnels via Resend.
# Sans RESEND_API_KEY, les emails sont loggues en dev et refuses en production.
# RESEND_API_KEY="re_xxxxxxxx"
FROM_EMAIL="noreply@clubproprete.com"
ADMIN_EMAIL="admin@clubproprete.com"

# Rate limiting production recommande: Upstash Redis.
# Le code actuel utilise un rate limiter en memoire si Redis n'est pas branche.
# UPSTASH_REDIS_REST_URL="https://[...].upstash.io"
# UPSTASH_REDIS_REST_TOKEN="[token]"

# Uploads production recommandes: stockage objet (Supabase Storage/R2/S3).
# Le stockage local public/uploads est uniquement durable en local.
# ALLOW_LOCAL_UPLOADS="false"
# NEXT_PUBLIC_SUPABASE_URL="https://[project].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
# SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Monitoring optionnel.
# SENTRY_DSN="https://..."
