# Base de donnees PostgreSQL (Supabase en production, Postgres local en dev).
# Avec Supabase, DATABASE_URL passe par le pooler (port 6543) et DIRECT_URL
# par la connexion directe (port 5432) pour les migrations Prisma.
DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# URL publique de l'application, utilisee pour les liens emails, sitemap et robots.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js v5
# Generer avec: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# Le host est approuve par defaut (Vercel). Mettre a "false" pour le refuser.
AUTH_TRUST_HOST="true"

# Connexion / inscription via Google (OAuth Auth.js).
# Cree un identifiant OAuth "Application Web" dans Google Cloud Console
# (https://console.cloud.google.com/apis/credentials) et ajoute comme URI de
# redirection autorisee : https://<ton-domaine>/api/auth/callback/google
# (et http://localhost:3000/api/auth/callback/google en local).
# Sans ces variables, le bouton Google est masque ; seul l'email/mot de passe reste actif.
# AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxx"

# Emails transactionnels via Resend.
# Sans RESEND_API_KEY, les emails sont loggues en dev et refuses en production.
# RESEND_API_KEY="re_xxxxxxxx"
FROM_EMAIL="noreply@clubproprete.com"
ADMIN_EMAIL="admin@clubproprete.com"

# Rate limiting production recommande: Upstash Redis.
# Le code actuel utilise un rate limiter en memoire si Redis n'est pas branche.
# UPSTASH_REDIS_REST_URL="https://[...].upstash.io"
# UPSTASH_REDIS_REST_TOKEN="[token]"

# Uploads production recommandes: stockage objet (Supabase Storage/R2/S3).
# Le stockage local public/uploads est uniquement durable en local.
# ALLOW_LOCAL_UPLOADS="false"
# NEXT_PUBLIC_SUPABASE_URL="https://[project].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
# SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Rate limiting distribue via Vercel KV (optionnel, fallback memoire sinon).
# Cree un store dans le dashboard Vercel : https://vercel.com/dashboard/stores
# KV_URL="https://[...].kv.vercel-storage.com"
# KV_REST_API_URL="https://[...].kv.vercel-storage.com"
# KV_REST_API_TOKEN="[token]"

# Monitoring optionnel.
# SENTRY_DSN="https://..."
