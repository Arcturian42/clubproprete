{
  "name": "clubproprete",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean:next": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "npm run clean:next && next build",
    "vercel-build": "node scripts/migrate-deploy.mjs && npm run clean:next && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "test:unit": "node --import tsx --test lib/permissions.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:e2e": "npm run build && PLAYWRIGHT_PORT=4567 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prisma:backfill-user-profiles": "tsx prisma/backfill-user-profiles.ts",
    "set-role": "tsx scripts/set-user-role.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/react-leaflet": "^2.8.3",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.49",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
